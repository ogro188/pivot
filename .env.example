# .env - Variables de Entorno para PIVOT Trading System
# Copia este archivo a .env y ajusta los valores

# ============================================
# DERIV API CONFIGURATION
# ============================================
# Obtén tu token en: https://app.deriv.com/account/api-token
DERIV_APP_ID=123456
DERIV_API_TOKEN=tu_token_secreto_aqui

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=sqlite:///data/storage/pivot.db

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
# Opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# API SERVER
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# WEBSOCKET SERVER
# ============================================
WS_HOST=0.0.0.0
WS_PORT=8765

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8765

# ============================================
# BACKTEST DEFAULTS
# ============================================
DEFAULT_CAPITAL_INICIAL=10000
DEFAULT_RISK_PERCENT=1.0
DEFAULT_TP_PIPS=30
DEFAULT_SL_PIPS=15

# ============================================
# TRADING LIMITS
# ============================================
MAX_POSICIONES_ABIERTAS=5
MAX_OPERACIONES_DIA=20
MAX_DRAWDOWN_DIARIO=0.05  # 5%

# ============================================
# ALERTS
# ============================================
ALERT_EMAIL=tu@email.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# PRODUCTION FLAGS
# ============================================
ENVIRONMENT=development
# Cambiar a 'production' en producción

DEBUG_MODE=true
# Cambiar a false en producción
