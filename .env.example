# .env - Variables de Entorno para PIVOT Trading System
# Copia este archivo a .env y ajusta los valores

# ============================================
# DERIV API CONFIGURATION
# ============================================
# Obtén tu token en: https://app.deriv.com/account/api-token
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_SYMBOL=1HZ100V
DERIV_TIMEFRAMES=M15,H1,H4,D1
DERIV_ACCOUNT_TYPE=virtual

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///app/data/pivot.db

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# ALERTAS NTFY (MERCADO EN VIVO)
# ============================================
# Default OFF: replay/backtest/prueba NO envían alertas live.
# Poner en 1 solo cuando se opere en vivo con datos Deriv reales.
PIVOT_ALERTAS_LIVE=0
